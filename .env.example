# Copy to .env.local and replace every placeholder before running install:preflight.
DATABASE_URL=postgresql://medclinic_app:replace-with-database-password@127.0.0.1:5432/medclinic_scheduler
APP_URL=https://clinic.example.edu
JWT_SECRET=replace-with-a-strong-random-secret-of-at-least-32-characters
APP_TIMEZONE=Asia/Manila
# SMTP delivery is mandatory for staff and student verification.
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
# Set both SMTP_USER and SMTP_PASS, or leave both empty when the server does not require authentication.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=clinic@example.edu
# Required Base64 encoding of exactly 32 random bytes; do not reuse JWT_SECRET.
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-a-dedicated-base64-encoded-32-byte-key
# Set these only in the process that runs `npm run admin:bootstrap`, then remove them.
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TEMPORARY_PASSWORD=
# Use an absolute path on durable private storage outside the repository and public/.
RESULT_UPLOAD_ROOT=C:/medclinic-data/private-result-uploads
