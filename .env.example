DATABASE_URL=postgresql://postgres:password@localhost:5432/medclinic_scheduler
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
APP_TIMEZONE=Asia/Manila
# Optional SMTP delivery. Portal notifications work without these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Required dedicated Base64 encoding of exactly 32 random bytes.
EMAIL_OUTBOX_ENCRYPTION_KEY=
# Set these only in the process that runs `npm run admin:bootstrap`, then remove them.
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TEMPORARY_PASSWORD=
# Keep this outside public/ and restrict it to the application OS account.
RESULT_UPLOAD_ROOT=.data/private-result-uploads
